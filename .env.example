# Copy to .env.local and fill in. Never commit real values — .env* is gitignored.
# All of these are read on the server only; none is exposed to the browser.

# --- Generation provider (required) -----------------------------------------
# Origin of the generation API. Requests go to POST {HF_API_BASE_URL}/{model-path}
# and GET {HF_API_BASE_URL}/requests/{request_id}/status.
HF_API_BASE_URL=https://your-generation-api.example.com

# Server-side API key, formatted id:secret. Sent as `Authorization: Key <id:secret>`.
# Optional: leave empty to let each visitor paste their own key in the studio
# (stored in an httpOnly cookie). When set, it takes precedence over browser keys.
HF_API_KEY=

# --- Access control (strongly recommended when HF_API_KEY is set) ------------
# Puts the whole studio behind HTTP Basic auth (any username, this password).
# Without it, anyone who can reach the URL spends your provider credits.
APP_PASSWORD=

# --- Upload storage (required for image/video/audio inputs) ------------------
# Option A: Vercel Blob (serverless-friendly). Either variable name works.
OPEN_HIGGSFIELD_READ_WRITE_TOKEN=
# BLOB_READ_WRITE_TOKEN=

# Option B: local disk (self-hosted, long-lived server with a disk).
# PUBLIC_BASE_URL must be an origin the provider can reach from the internet.
# STORAGE_DRIVER=local
# PUBLIC_BASE_URL=https://studio.example.com
# LOCAL_UPLOAD_DIR=.uploads

# Development only: allow media URLs on localhost/private networks (the real
# provider cannot fetch these; useful with a mock provider).
# ALLOW_PRIVATE_MEDIA_URLS=true

# --- Site metadata (optional) ------------------------------------------------
# NEXT_PUBLIC_SITE_URL=https://studio.example.com
